# Public origin of this deployment. Drives the page metadata, the /api/v1
# index and every generated code snippet.
#
# NEXT_PUBLIC_ means Next inlines it at build time, so changing it needs a
# rebuild rather than just a restart — which is what a Coolify redeploy does.
NEXT_PUBLIC_SITE_URL=https://tools.truvibe.dev

# Redis backing the public API rate limiter.
# If unset, the app falls back to an in-process limiter — fine for local dev,
# wrong for production (resets on redeploy, and is per-replica).
# Port 6380 matches docker-compose.yml, which avoids the Redis already on 6379.
REDIS_URL=redis://localhost:6380

# Only set this when a CDN sits in front and is the authority on the caller's
# address, e.g. CLIENT_IP_HEADER=cf-connecting-ip behind Cloudflare. Without a
# CDN, leave it unset — trusting such a header when nothing guarantees it would
# let anyone spoof their own address.
# CLIENT_IP_HEADER=

# Set to 1 to expose /ip?debug in production. It lists every forwarding header
# that arrived and marks each chain entry public or private, which is how you
# find out why a reported address is wrong. On automatically outside production.
# IP_DEBUG=1

# Public API rate limit, per IP. Defaults to 60 requests per 60 seconds.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
